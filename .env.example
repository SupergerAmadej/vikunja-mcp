VIKUNJA_TOKEN=replace_with_a_scoped_vikunja_token
VIKUNJA_MCP_API_KEY=replace_with_a_random_mcp_secret
VIKUNJA_JWT_SECRET=replace_with_a_random_vikunja_secret
# The Compose backend includes the reviewed atomic-field extension.
# Explicitly setting 0 opts into stock compatibility and its concurrency limits.
VIKUNJA_REQUIRE_ATOMIC_UPDATES=1
