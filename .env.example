VIKUNJA_TOKEN=replace_with_a_scoped_vikunja_token
VIKUNJA_MCP_API_KEY=replace_with_a_random_mcp_secret
VIKUNJA_JWT_SECRET=replace_with_a_random_vikunja_secret
# Prefer atomic field updates when advertised; otherwise use stock compatibility.
# Set 1 only when the operator requires the optional backend extension.
VIKUNJA_REQUIRE_ATOMIC_UPDATES=0
