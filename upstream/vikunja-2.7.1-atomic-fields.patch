+func TestAtomicFieldUpdatesPermissions(t *testing.T) {
+	for _, test := range []struct {
+		resource string
+		id       string
+		owner    int64
+	}{
+		{
+			resource: "tasks",
+			id:       "32",
+			owner:    3,
+		},
+		{
+			resource: "projects",
+			id:       "3",
+			owner:    3,
+		},
+		{
+			resource: "labels",
+			id:       "3",
+			owner:    2,
+		},
+	} {
+		t.Run(test.resource, func(t *testing.T) {
+			e, err := setupTestEnv()
+			require.NoError(t, err)
+			ownerToken := humaTokenFor(t, &user.User{ID: test.owner})
+			path := "/api/v2/" + test.resource + "/" + test.id
+			read := humaRequest(t, e, http.MethodGet, path+"?format=html", "", ownerToken, "")
+			require.Equal(t, http.StatusOK, read.Code, read.Body.String())
+			body := map[string]any{}
+			require.NoError(t, json.Unmarshal(read.Body.Bytes(), &body))
+			title := body["title"]
+			body["title"] = "Forbidden"
+			body["update_fields"] = []string{"title"}
+			denied := humaRequest(t, e, http.MethodPost, path+"/fields?format=html", fieldUpdateJSON(t, body), humaTokenFor(t, &testuser1), "")
+			require.Equal(t, http.StatusForbidden, denied.Code, denied.Body.String())
+			after := humaRequest(t, e, http.MethodGet, path+"?format=html", "", ownerToken, "")
+			require.NoError(t, json.Unmarshal(after.Body.Bytes(), &body))
+			assert.Equal(t, title, body["title"])
+		})
+	}
+}
