@@ -0,0 +1,143 @@
+// Vikunja is a to-do list application to facilitate your life.
+// Copyright 2018-present Vikunja and contributors. All rights reserved.
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package models
+
+import (
+	"code.vikunja.io/api/pkg/web"
+	"xorm.io/xorm"
+)
+
+var taskUpdateFields = []string{
+	"title",
+	"description",
+	"done",
+	"due_date",
+	"repeat_after",
+	"priority",
+	"start_date",
+	"end_date",
+	"hex_color",
+	"percent_done",
+	"project_id",
+	"bucket_id",
+	"repeat_mode",
+	"cover_image_attachment_id",
+	"assignees",
+	"reminders",
+	"is_favorite",
+}
+
+func checkedUpdateFields(fields, allowed []string) (map[string]bool, error) {
+	if fields == nil {
+		return nil, nil
+	}
+	if len(fields) == 0 {
+		return nil, ErrInvalidModel{Message: "update_fields must not be empty"}
+	}
+	choices := make(map[string]bool, len(allowed))
+	for _, field := range allowed {
+		choices[field] = true
+	}
+	selected := make(map[string]bool, len(fields))
+	for _, field := range fields {
+		if !choices[field] {
+			return nil, ErrInvalidModel{Message: "Unknown update field: " + field}
+		}
+		if selected[field] {
+			return nil, ErrInvalidModel{Message: "Duplicate update field: " + field}
+		}
+		selected[field] = true
+	}
+	return selected, nil
+}
+
+func (p *Project) prepareFieldUpdate(s *xorm.Session, a web.Auth) (map[string]bool, error) {
+	selected, err := checkedUpdateFields(p.UpdateFields, []string{
+		"title",
+		"description",
+		"identifier",
+		"hex_color",
+		"is_favorite",
+		"is_archived",
+		"parent_project_id",
+		"position",
+	})
+	if err != nil || selected == nil {
+		return selected, err
+	}
+	if p.ID < 1 {
+		return nil, ErrInvalidModel{Message: "Field updates require a real project"}
+	}
+	// Bypass permission-query memoization and lock the authoritative row for
+	// the transaction before interpreting archive/reparent side effects.
+	stored := &Project{}
+	exists, err := lockingSession(s).ID(p.ID).Get(stored)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, ErrProjectDoesNotExist{ID: p.ID}
+	}
+	if !selected["title"] {
+		p.Title = stored.Title
+	}
+	if !selected["description"] {
+		p.Description = stored.Description
+	}
+	if !selected["identifier"] {
+		p.Identifier = stored.Identifier
+	}
+	if !selected["hex_color"] {
+		p.HexColor = stored.HexColor
+	}
+	if !selected["is_archived"] {
+		p.IsArchived = stored.IsArchived
+	}
+	if !selected["position"] {
+		p.Position = stored.Position
+	}
+	if !selected["parent_project_id"] {
+		p.ParentProjectID = nil
+	} else if p.ParentProjectID == nil {
+		p.ParentProjectID = noParentProjectID()
+	}
+	if !selected["is_favorite"] {
+		p.IsFavorite, err = isFavorite(s, p.ID, a, FavoriteKindProject)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return selected, nil
+}
+
+func validateFieldUpdateReminders(task *Task) error {
+	for _, reminder := range task.Reminders {
+		if reminder == nil {
+			return ErrInvalidModel{Message: "A reminder must not be null"}
+		}
+		switch reminder.RelativeTo {
+		case "":
+			if reminder.Reminder.IsZero() {
+				return ErrInvalidModel{Message: "An absolute reminder needs a timestamp"}
+			}
+		case ReminderRelationDueDate:
+			if task.DueDate.IsZero() {
+				return ErrInvalidModel{Message: "Relative reminder due_date is not set"}
+			}
+		case ReminderRelationStartDate:
+			if task.StartDate.IsZero() {
+				return ErrInvalidModel{Message: "Relative reminder start_date is not set"}
+			}
+		case ReminderRelationEndDate:
+			if task.EndDate.IsZero() {
+				return ErrInvalidModel{Message: "Relative reminder end_date is not set"}
+			}
+		default:
+			return ErrInvalidModel{Message: "Unknown relative reminder base"}
+		}
+	}
+	return nil
+}
