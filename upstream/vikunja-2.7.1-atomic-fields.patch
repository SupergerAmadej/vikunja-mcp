+++ b/pkg/routes/api/v2/field_updates.go
@@ -0,0 +1,103 @@
+// Vikunja is a to-do list application to facilitate your life.
+// Copyright 2018-present Vikunja and contributors. All rights reserved.
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package apiv2
+
+import (
+	"context"
+	"net/http"
+
+	"code.vikunja.io/api/pkg/models"
+	"github.com/danielgtaylor/huma/v2"
+)
+
+func init() { AddRouteRegistrar(RegisterFieldUpdateRoutes) }
+
+func RegisterFieldUpdateRoutes(api huma.API) {
+	Register(api, huma.Operation{
+		OperationID:   "tasks-update-fields",
+		Summary:       "Update selected task fields",
+		Description:   "Applies only update_fields within the update transaction, preserving omitted scalar fields, assignees, reminders and favorites. The body follows the task read shape and requires a non-empty field mask. Uses the normal task write permissions. A missing route must not be retried as a full replacement.",
+		Method:        http.MethodPost,
+		Path:          "/tasks/{task}/fields",
+		Tags:          []string{"tasks"},
+		DefaultStatus: http.StatusOK,
+	}, taskFieldsUpdate)
+	Register(api, huma.Operation{
+		OperationID:   "projects-update-fields",
+		Summary:       "Update selected project fields",
+		Description:   "Applies only update_fields, including explicit description clears. Omitted archive, parent and favorite state is preserved. Requires normal project write permission and admin permission for reparenting.",
+		Method:        http.MethodPost,
+		Path:          "/projects/{id}/fields",
+		Tags:          []string{"projects"},
+		DefaultStatus: http.StatusOK,
+	}, projectFieldsUpdate)
+	Register(api, huma.Operation{
+		OperationID:   "labels-update-fields",
+		Summary:       "Update selected label fields",
+		Description:   "Applies only the named title, description or hex_color fields. Requires a non-empty update_fields mask and the existing label update permission.",
+		Method:        http.MethodPost,
+		Path:          "/labels/{id}/fields",
+		Tags:          []string{"labels"},
+		DefaultStatus: http.StatusOK,
+	}, labelFieldsUpdate)
+}
+
+func taskFieldsUpdate(ctx context.Context, in *struct {
+	ID     int64  `path:"task" minimum:"1"`
+	Format string `query:"format" enum:"html,markdown" doc:"How rich-text fields are exchanged."`
+	Body   taskReadOneBody
+}) (*singleBody[models.Task], error) {
+	if len(in.Body.UpdateFields) == 0 {
+		return nil, huma.Error422UnprocessableEntity("A non-empty update_fields mask is required")
+	}
+	return tasksUpdate(ctx, &struct {
+		ID     int64  `path:"task"`
+		Format string `query:"format" enum:"html,markdown" doc:"How rich-text fields are exchanged. See the API description."`
+		Body   taskReadOneBody
+	}{
+		ID:     in.ID,
+		Format: in.Format,
+		Body:   in.Body,
+	})
+}
+
+func projectFieldsUpdate(ctx context.Context, in *struct {
+	ID     int64  `path:"id" minimum:"1"`
+	Format string `query:"format" enum:"html,markdown" doc:"How rich-text fields are exchanged."`
+	Body   projectReadBody
+}) (*singleBody[models.Project], error) {
+	if len(in.Body.UpdateFields) == 0 {
+		return nil, huma.Error422UnprocessableEntity("A non-empty update_fields mask is required")
+	}
+	return projectsUpdate(ctx, &struct {
+		ID     int64  `path:"id"`
+		Format string `query:"format" enum:"html,markdown" doc:"How rich-text fields are exchanged. See the API description."`
+		Body   projectReadBody
+	}{
+		ID:     in.ID,
+		Format: in.Format,
+		Body:   in.Body,
+	})
+}
+
+func labelFieldsUpdate(ctx context.Context, in *struct {
+	ID     int64  `path:"id" minimum:"1"`
+	Format string `query:"format" enum:"html,markdown" doc:"How rich-text fields are exchanged."`
+	Body   labelReadBody
+}) (*singleBody[models.Label], error) {
+	if len(in.Body.UpdateFields) == 0 {
+		return nil, huma.Error422UnprocessableEntity("A non-empty update_fields mask is required")
+	}
+	return labelsUpdate(ctx, &struct {
+		ID     int64  `path:"id"`
+		Format string `query:"format" enum:"html,markdown" doc:"How rich-text fields are exchanged. See the API description."`
+		Body   labelReadBody
+	}{
+		ID:     in.ID,
+		Format: in.Format,
+		Body:   in.Body,
+	})
+}
