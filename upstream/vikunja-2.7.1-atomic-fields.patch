--- /dev/null
+++ b/pkg/webtests/huma_field_updates_test.go
@@ -0,0 +1,203 @@
+// Vikunja is a to-do list application to facilitate your life.
+// Copyright 2018-present Vikunja and contributors. All rights reserved.
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package webtests
+
+import (
+	"encoding/json"
+	"fmt"
+	"maps"
+	"net/http"
+	"testing"
+
+	"code.vikunja.io/api/pkg/user"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAtomicFieldUpdatesInheritedPermissionAndReparenting(t *testing.T) {
+	e, err := setupTestEnv()
+	require.NoError(t, err)
+	ownerToken := humaTokenFor(t, &testuser1)
+	read := humaRequest(t, e, http.MethodGet, "/api/v2/projects/1?format=html", "", ownerToken, "")
+	require.Equal(t, http.StatusOK, read.Code, read.Body.String())
+	stale := map[string]any{}
+	require.NoError(t, json.Unmarshal(read.Body.Bytes(), &stale))
+	created := humaRequest(t, e, http.MethodPost, "/api/v2/projects", `{"title":"Field-update parent"}`, ownerToken, "")
+	require.Equal(t, http.StatusCreated, created.Code, created.Body.String())
+	parent := map[string]any{}
+	require.NoError(t, json.Unmarshal(created.Body.Bytes(), &parent))
+	parentID := int64(parent["id"].(float64))
+	shared := humaRequest(t, e, http.MethodPut, fmt.Sprintf("/api/v1/projects/%d/users", parentID), `{"username":"user2","permission":1}`, ownerToken, "")
+	require.Equal(t, http.StatusCreated, shared.Code, shared.Body.String())
+	moved := maps.Clone(stale)
+	moved["parent_project_id"] = parentID
+	changed := humaRequest(t, e, http.MethodPost, "/api/v1/projects/1", fieldUpdateJSON(t, moved), ownerToken, "")
+	require.Equal(t, http.StatusOK, changed.Code, changed.Body.String())
+
+	stale["title"] = "Inherited field edit"
+	stale["update_fields"] = []string{"title"}
+	writer := humaTokenFor(t, &user.User{ID: 2})
+	updated := humaRequest(t, e, http.MethodPost, "/api/v2/projects/1/fields?format=html", fieldUpdateJSON(t, stale), writer, "")
+	require.Equal(t, http.StatusOK, updated.Code, updated.Body.String())
+	current := map[string]any{}
+	require.NoError(t, json.Unmarshal(updated.Body.Bytes(), &current))
+	assert.Equal(t, float64(parentID), current["parent_project_id"])
+	assert.Equal(t, "Inherited field edit", current["title"])
+
+	current["parent_project_id"] = nil
+	current["update_fields"] = []string{"parent_project_id"}
+	denied := humaRequest(t, e, http.MethodPost, "/api/v2/projects/1/fields?format=html", fieldUpdateJSON(t, current), writer, "")
+	require.Equal(t, http.StatusForbidden, denied.Code, denied.Body.String())
+	detached := humaRequest(t, e, http.MethodPost, "/api/v2/projects/1/fields?format=html", fieldUpdateJSON(t, current), ownerToken, "")
+	require.Equal(t, http.StatusOK, detached.Code, detached.Body.String())
+	require.NoError(t, json.Unmarshal(detached.Body.Bytes(), &current))
+	assert.Equal(t, float64(0), current["parent_project_id"])
+	assert.Equal(t, "Inherited field edit", current["title"])
+}
+
+func fieldUpdateJSON(t *testing.T, value any) string {
+	t.Helper()
+	body, err := json.Marshal(value)
+	require.NoError(t, err)
+	return string(body)
+}
+
+func TestAtomicFieldUpdates(t *testing.T) {
+	for _, resource := range []string{
+		"tasks",
+		"projects",
+		"labels",
+	} {
+		t.Run(resource, func(t *testing.T) {
+			e, err := setupTestEnv()
+			require.NoError(t, err)
+			token := humaTokenFor(t, &testuser1)
+			path := "/api/v2/" + resource + "/1"
+			read := humaRequest(t, e, http.MethodGet, path+"?format=html", "", token, "")
+			require.Equal(t, http.StatusOK, read.Code, read.Body.String())
+			stale := map[string]any{}
+			require.NoError(t, json.Unmarshal(read.Body.Bytes(), &stale))
+			external := maps.Clone(stale)
+			external["description"] = "External description"
+			if resource == "tasks" {
+				external["assignees"] = []map[string]any{
+					{"id": 1},
+				}
+				external["reminders"] = []map[string]any{
+					{"reminder": "2027-01-01T00:00:00Z"},
+				}
+				external["is_favorite"] = true
+			}
+			if resource != "tasks" {
+				external["hex_color"] = "abcdef"
+			}
+			changed := humaRequest(t, e, http.MethodPost, "/api/v1/"+resource+"/1", fieldUpdateJSON(t, external), token, "")
+			require.Equal(t, http.StatusOK, changed.Code, changed.Body.String())
+
+			stale["title"] = "Masked title"
+			stale["update_fields"] = []string{"title"}
+			updated := humaRequest(t, e, http.MethodPost, path+"/fields?format=html", fieldUpdateJSON(t, stale), token, "")
+			require.Equal(t, http.StatusOK, updated.Code, updated.Body.String())
+			after := humaRequest(t, e, http.MethodGet, path+"?format=html", "", token, "")
+			require.Equal(t, http.StatusOK, after.Code, after.Body.String())
+			stored := map[string]any{}
+			require.NoError(t, json.Unmarshal(after.Body.Bytes(), &stored))
+			assert.Equal(t, "Masked title", stored["title"])
+			assert.Equal(t, "External description", stored["description"])
+			assert.NotContains(t, stored, "update_fields")
+			if resource == "tasks" {
+				assert.Equal(t, true, stored["is_favorite"])
+				require.Len(t, stored["assignees"], 1)
+				require.Len(t, stored["reminders"], 1)
+			} else {
+				assert.Equal(t, "abcdef", stored["hex_color"])
+			}
+
+			if resource == "projects" {
+				stored["description"] = ""
+				stored["update_fields"] = []string{"description"}
+				cleared := humaRequest(t, e, http.MethodPost, path+"/fields?format=html", fieldUpdateJSON(t, stored), token, "")
+				require.Equal(t, http.StatusOK, cleared.Code, cleared.Body.String())
+				require.NoError(t, json.Unmarshal(cleared.Body.Bytes(), &stored))
+				assert.Equal(t, "", stored["description"])
+			}
+		})
+	}
+}
